# ==============================================================================
# BAGIAN 1: SECRET (RAHASIA - HANYA BACKEND / SERVER)
# JANGAN PERNAH BOCOR KE PUBLIK / GITHUB.
# Di Vercel: Masukkan ke kategori "Sensitive" (Ikon Gembok).
# ==============================================================================

# Database Connection (Neon PostgreSQL - https://neon.tech)
DATABASE_URL="postgresql://[USERNAME]:[PASSWORD]@[EP_HOST].ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Kunci Rahasia Pembuat Serial Key Lisensi (Wajib sama persis dengan di aplikasi Android)
LICENSE_SALT="POS_PRO_OFFLINE_SECRET_SALT_V1_2026"

# Kredensial Masuk Halaman Admin (/admin)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti_password_aman_anda"

# Midtrans Merchant ID & Server Key (Dapatkan di https://dashboard.midtrans.com -> Settings -> Access Keys)
MIDTRANS_MERCHANT_ID="masukkan_merchant_id_anda"
MIDTRANS_SERVER_KEY="masukkan_server_key_midtrans_anda"
# Resend Email Service API Key (Gratis 3.000 email/bulan di https://resend.com)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# ==============================================================================
# BAGIAN 2: CONFIG & PUBLIK (KONFIGURASI UMUM & BROWSER)
# Variabel yang aman dibaca publik atau dibutuhkan oleh browser (NEXT_PUBLIC_).
# Di Vercel: Bisa dimasukkan sebagai standar (Standard).
# ==============================================================================

# URL Lengkap Website (Digunakan untuk Redirect Midtrans, Link Email, & SEO)
NEXT_PUBLIC_SITE_URL="https://www.linkwebkamu.com"

# Midtrans Client Key & Environment Flag (Dibaca browser untuk memunculkan Snap popup)

MIDTRANS_IS_PRODUCTION="true"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="true"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="masukkan_client_key_midtrans_anda"
PAYMENT_GATEWAY_PROVIDER="midtrans"

# Pengirim Email Resend (Harus domain terverifikasi di Resend)
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Link File APK Installer (Server-side untuk email download link & admin)
APK_DRIVE_URL="https://drive.google.com/file/d/YOUR_FILE_ID/view"
# Link File APK Installer (Client-side untuk halaman detail pesanan)
NEXT_PUBLIC_APK_DRIVE_URL="https://drive.google.com/file/d/YOUR_FILE_ID/view"

# Kontak Admin 1 (Bantuan Teknis & Aktivasi)
NEXT_PUBLIC_ADMIN_FILAMSI_NAME="admin1"
NEXT_PUBLIC_ADMIN_FILAMSI_WA="nomor_admin1"

# Kontak Admin 2 (Konsultasi & Pembelian)
NEXT_PUBLIC_ADMIN_ARIYO_NAME="admin2"
NEXT_PUBLIC_ADMIN_ARIYO_WA="nomor_admin2"

# Meta Pixel ID (Facebook / Instagram Ads Tracking)
NEXT_PUBLIC_META_PIXEL_ID=""
