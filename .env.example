# ==========================================
# DATABASE (Neon PostgreSQL)
# Buat akun di https://neon.tech dan salin connection string
# ==========================================
DATABASE_URL="postgresql://user:password@ep-project.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# LISENSI & ADMIN
# ==========================================
# Kunci rahasia untuk generate serial key (WAJIB SAMA dengan di aplikasi Android)
LICENSE_SALT="POS_PRO_OFFLINE_SECRET_SALT_V1_2026"

# Kredensial login halaman admin (/admin)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti_password_aman_anda"

# ==========================================
# MIDTRANS PAYMENT GATEWAY (SNAP API)
# Dapatkan di: https://dashboard.midtrans.com -> Settings -> Access Keys
# ==========================================
# Merchant ID (didapat dari dashboard Midtrans)
MIDTRANS_MERCHANT_ID="masukkan_merchant_id_anda"

# Server Key (Privat / Rahasia - HANYA dibaca oleh server)
# Contoh format: diawali Mid-server- (Production) atau SB-Mid-server- (Sandbox)
MIDTRANS_SERVER_KEY="masukkan_server_key_midtrans_anda"

# Client Key (Publik - dibaca oleh browser untuk memunculkan modal Snap pop-up)
# Contoh format: diawali Mid-client- (Production) atau SB-Mid-client- (Sandbox)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="masukkan_client_key_midtrans_anda"

# Flag Environment: "true" untuk Production, "false" untuk Sandbox
MIDTRANS_IS_PRODUCTION="true"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="true"

# Provider penanda
PAYMENT_GATEWAY_PROVIDER="midtrans"

# ==========================================
# EMAIL (Resend - https://resend.com)
# Gratis 3.000 email/bulan. Daftar di resend.com
# ==========================================
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Pengirim email: harus domain yang sudah diverifikasi di dashboard Resend (contoh: onboarding@resend.dev atau noreply@domainanda.com)
RESEND_FROM_EMAIL="onboarding@resend.dev"

# ==========================================
# LINK PRODUK
# ==========================================
# Link Google Drive tempat file APK POS OFFLINE disimpan (otomatis di-bypass ke direct download)
APK_DRIVE_URL="https://drive.google.com/file/d/YOUR_FILE_ID/view"
NEXT_PUBLIC_APK_DRIVE_URL="https://drive.google.com/file/d/YOUR_FILE_ID/view"
# (Opsional) Jika di masa depan menggunakan Cloudflare R2 / Supabase Storage / S3
# APK_DIRECT_URL="https://cdn.domainanda.com/POS-OFFLINE.apk"


# ==========================================
# INFORMASI PUBLIK (diakses oleh browser)
# Variabel NEXT_PUBLIC_ bisa dibaca di client side
# ==========================================
# Nomor WhatsApp admin utama (format: kode negara tanpa + diikuti nomor tanpa 0)
NEXT_PUBLIC_WA_NUMBER="nomor_admin1"

# Kontak Admin admin1 (Bantuan Teknis & Aktivasi)
NEXT_PUBLIC_ADMIN_FILAMSI_NAME="admin1"
NEXT_PUBLIC_ADMIN_FILAMSI_PHONE="nomor_admin1"
NEXT_PUBLIC_ADMIN_FILAMSI_WA="nomor_admin1"

# Kontak Admin admin2 (Konsultasi & Pembelian)
NEXT_PUBLIC_ADMIN_ARIYO_NAME="admin2"
NEXT_PUBLIC_ADMIN_ARIYO_PHONE="nomor_admin2"
NEXT_PUBLIC_ADMIN_ARIYO_WA="nomor_admin2"

# Meta Pixel ID untuk tracking Facebook/Instagram Ads
# Dapatkan di: business.facebook.com -> Events Manager -> Connect Data Sources
NEXT_PUBLIC_META_PIXEL_ID=""

# URL lengkap website (tanpa trailing slash)
# Contoh: http://localhost:3000 atau https://www.posoffline.xyz
NEXT_PUBLIC_SITE_URL="https://www.posoffline.xyz"
